{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "type", "title", "updated_at", "data_as_of", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "type": { "type": "string", "enum": ["industry", "company"] },
    "title": { "type": "string", "minLength": 1 },
    "ticker": { "type": "string" },
    "market": { "type": "string" },
    "status": { "type": "string", "enum": ["researchable", "wait_for_price", "observe", "exclude"] },
    "model_id": { "type": "string" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "data_as_of": { "type": "string", "minLength": 4 },
    "scores": {
      "type": "object",
      "required": ["industry_benefit", "financial_conversion", "valuation_setup", "expectation_gap"],
      "properties": {
        "industry_benefit": { "$ref": "#/$defs/score" },
        "financial_conversion": { "$ref": "#/$defs/score" },
        "valuation_setup": { "$ref": "#/$defs/score" },
        "expectation_gap": { "$ref": "#/$defs/score" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": ["value", "label", "reason"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "label": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 12 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "company" } } },
      "then": { "required": ["ticker", "market", "status", "scores"] }
    }
  ],
  "additionalProperties": true
}
